# Builds the portable Windows package. Run by the `package_zip` target:
#   cmake -DSOURCE_DIR=... -DBUILD_DIR=... -DVERSION=... -DEXE=... -DLOGTOOL=...
#         -DWINDEPLOYQT=... -DQT_VERSION=... -DRUNTIME_LIBS="a;b" -P package.cmake
#
# Result: <SOURCE_DIR>/dist/CANSignalAnalyzer-<VERSION>-win64.zip
cmake_minimum_required(VERSION 3.21)

set(NAME "CANSignalAnalyzer-${VERSION}-win64")
set(STAGE_ROOT "${BUILD_DIR}/dist-stage")
set(STAGE "${STAGE_ROOT}/${NAME}")
set(DIST "${SOURCE_DIR}/dist")
set(ZIP "${DIST}/${NAME}.zip")

file(REMOVE_RECURSE "${STAGE_ROOT}")
file(MAKE_DIRECTORY "${STAGE}" "${STAGE}/samples" "${DIST}")

# 1. Executables.
file(COPY "${EXE}" "${LOGTOOL}" DESTINATION "${STAGE}")
get_filename_component(EXE_NAME "${EXE}" NAME)
get_filename_component(LOGTOOL_NAME "${LOGTOOL}" NAME)

# 2. Qt runtime (release DLLs, plugins, QML modules).
execute_process(
    COMMAND "${WINDEPLOYQT}" --release --qmldir "${SOURCE_DIR}/src/app" --no-translations
            --no-system-d3d-compiler --no-opengl-sw --no-compiler-runtime
            "${STAGE}/${EXE_NAME}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "windeployqt failed (${rc}):\n${out}\n${err}")
endif()
# The console tool needs Qt Core only (already deployed for the app).

# 3. Visual C++ runtime, application-local.
foreach(lib IN LISTS RUNTIME_LIBS)
    if(EXISTS "${lib}")
        file(COPY "${lib}" DESTINATION "${STAGE}")
    endif()
endforeach()

# 4. No debug files in the package.
file(GLOB_RECURSE debug_files "${STAGE}/*.pdb" "${STAGE}/*.ilk" "${STAGE}/*.exp" "${STAGE}/*.lib"
                              "${STAGE}/*d.dll.debug")
if(debug_files)
    file(REMOVE ${debug_files})
endif()

# 5. Samples: the demo database and a 60 s log generated by the simulator.
file(COPY "${SOURCE_DIR}/src/core/resources/demo_vehicle.dbc" DESTINATION "${STAGE}/samples")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env "PATH=${STAGE};$ENV{SystemRoot}/System32"
            "${STAGE}/${LOGTOOL_NAME}" generate --out "${STAGE}/samples/demo_drive_60s.canlog" --seconds 60 --rate 1000
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "generating the sample log failed (${rc}):\n${out}\n${err}")
endif()
message(STATUS "${out}")

# 6. Documents.
string(REGEX MATCH "^[0-9]+\\.[0-9]+" QT_VERSION_MAJOR_MINOR "${QT_VERSION}")
configure_file("${SOURCE_DIR}/packaging/README.md" "${STAGE}/README.md" @ONLY)
configure_file("${SOURCE_DIR}/LICENSE" "${STAGE}/LICENSE.txt" COPYONLY)
file(COPY "${SOURCE_DIR}/packaging/THIRD_PARTY" DESTINATION "${STAGE}")
foreach(doc "THIRD_PARTY/README.md" "THIRD_PARTY/Qt/NOTICE.md")
    configure_file("${SOURCE_DIR}/packaging/${doc}" "${STAGE}/${doc}" @ONLY)
endforeach()
file(COPY "${SOURCE_DIR}/docs/log-format.md" DESTINATION "${STAGE}/docs")

# 7. Zip (the archive contains one top-level folder).
file(REMOVE "${ZIP}")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E tar cf "${ZIP}" --format=zip "${NAME}"
    WORKING_DIRECTORY "${STAGE_ROOT}"
    RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "creating ${ZIP} failed")
endif()
file(SIZE "${ZIP}" zip_size)
math(EXPR zip_mb "${zip_size} / 1048576")
message(STATUS "Package: ${ZIP} (${zip_mb} MiB)")

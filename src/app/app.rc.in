// Windows resources: application icon and version information (Explorer >
// Properties > Details). Generated by CMake from app.rc.in.
#include <winver.h>

IDI_ICON1 ICON "@CAN_APP_ICO@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "CAN Analyzer"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "can_analyzer"
            VALUE "OriginalFilename", "can_analyzer.exe"
            VALUE "ProductName", "CAN Analyzer"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "CAN signal analyzer for simulated and recorded CAN traffic. Uses Qt under the LGPLv3."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
